# Dockerfile para desarrollo local con Docker Compose
# Usa la configuracion environment.docker.ts

# Etapa 1: Build Angular con config docker
FROM node:20 AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build -- --configuration docker

# Etapa 2: Nginx para servir
FROM nginx:1.28-alpine

COPY --from=build /app/dist/secani-front/browser /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
